[Unit]
Description=OMP DigiCoach server
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
User=omp
Group=omp
WorkingDirectory=/srv/omp-digicoach/app/server
EnvironmentFile=/etc/omp-digicoach/env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
