{
  "name": "@omp/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --conditions=development src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node bin/run.mjs db/migrate",
    "db:seed": "node --env-file-if-exists=.env --conditions=development src/db/seed.ts",
    "db:reset-test": "node --env-file-if-exists=.env --conditions=development src/db/reset-test.ts",
    "db:generate": "NODE_OPTIONS=--conditions=development drizzle-kit generate",
    "create-admin": "node bin/run.mjs cli/create-admin"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@node-rs/argon2": "2.2.1",
    "@omp/shared": "0.0.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10"
  }
}
